# ---------------------------------------------------------------------------
# ML artifacts
# ---------------------------------------------------------------------------
# Only the active weights are versioned. Retraining output, checkpoints and
# superseded models stay local - see docs/architecture.md for the weight
# release process.
runs/
wandb/
mlruns/
datasets/
*.onnx
*.engine
*.torchscript
backend/models/*.pt
!backend/models/bestv3.pt
earlier model/
*.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Evidence media
# ---------------------------------------------------------------------------
# Media is excluded by default, but the two seller/courier samples ARE
# committed: without them a fresh clone returns HTTP 424 and the service
# cannot be run at all.
*.mp4
*.mov
*.avi
*.mkv
dummy_data/*
!dummy_data/.gitkeep
!dummy_data/README.md
!dummy_data/seller_video.mp4
!dummy_data/courier_photo.jpg
uploads/
tmp/

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
node_modules/
.next/
.nuxt/
.svelte-kit/
frontend/dist/
frontend/build/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------------------------------------------------------------------------
