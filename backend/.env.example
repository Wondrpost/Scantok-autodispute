# backend/.env.example
#
# Copy to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env
#
# backend/.env is excluded from the Docker build context by .dockerignore
# (never baked into the image) and from the image's requirements install -
# it's injected at container-run time via `--env-file` / compose `env_file:`.
# Everything below is read with os.getenv(), so an unset var just falls back
# to the default already in main.py / agent_vision.py.

# --- External services ------------------------------------------------------
# NOTE: not read by main.py or agent_vision.py yet - add the os.getenv() call
# wherever your dataset-download / retraining tooling needs it before this
# actually does anything.
ROBOFLOW_API_KEY=

# --- Server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*
MAX_UPLOAD_MB=2000
MAX_CONCURRENT_DISPUTES=1

# --- Evidence paths ------------------------------------------------------
DUMMY_DATA_DIR=/dummy_data
SELLER_VIDEO_NAME=seller_video.mp4
COURIER_PHOTO_NAME=courier_photo.jpg

# --- YOLO / inference ------------------------------------------------------
YOLO_MODEL_PATH=/srv/models/bestv3.pt
# YOLO_DEVICE=cuda:0        # unset = auto-detect, falls back to CPU safely
# YOLO_BATCH_SIZE=4         # unset = auto-scaled from VRAM
YOLO_IMG_SIZE=640
YOLO_CONF_THRESHOLD=0.35
YOLO_HALF=true

# --- Sampling / damage logic ------------------------------------------------
SAMPLE_FPS=1.0
MAX_SAMPLED_FRAMES=90
MAX_DECODE_WIDTH=1280
# A "Damaged" verdict needs BOTH thresholds: an absolute floor of flagged
# frames and a proportion of the window. The floor alone misfires on short
# pre-open windows (1 of 4 frames is not evidence); the ratio alone misfires
# on single-frame stills. NOTE: 0.30 is a reasoned starting point, not a
# calibrated value - tune it against labelled packages before production.
DAMAGE_MIN_HITS=2
DAMAGE_MIN_RATIO=0.30
DAMAGE_CLASSES=damage,damaged,dent,torn,tear,rip,crush,crumpl,broken,break,wet,leak,scratch,hole,rusak,penyok,sobek,basah,robek
PACKAGE_CLASSES=package,packages,box,boxes,parcel,paket,kardus
DAMAGE_FALLBACK_HEURISTIC=true
EDGE_DENSITY_THRESHOLD=0.085

# --- Unboxing phase segmentation (buyer video only) -------------------------
# Splits the buyer's video at T_open so the buyer's own scissors are never
# mistaken for courier damage. See agent_vision.analyze_unboxing_video.
OPEN_CONTACT_RATIO=0.35      # hand-area-inside-package needed to call it contact
OPEN_MOTION_RATIO=0.18       # fallback signal when model has no hand/tool class
OPEN_CONSECUTIVE=2           # consecutive triggered samples before T_open fires
OPEN_BACKOFF_SEC=1.5         # rewind from T_open; 1 fps sampling is imprecise
MAX_PRE_OPEN_SEC=60          # ceiling on pre-open phase if opening never detected
MIN_PRE_FRAMES=3             # below this, packaging verdict is Invalid
# Second pass re-samples [0, T_open] at this rate. The pre-open window is a
# few seconds of a minutes-long clip but carries the whole transit-damage
# verdict, so it earns denser sampling than the rest. Set to SAMPLE_FPS to
# disable the rescan.
PRE_OPEN_SAMPLE_FPS=3.0
INTERVENTION_CLASSES=hand,person,finger,scissor,knife,cutter,blade,tangan,gunting,pisau,silet
OPENING_ARTIFACT_CLASSES=seal_cut,cut_tape,tape_cut,tape_removed,unsealed,flap_open,opened,open_box,segel,terbuka
PRODUCT_CLASSES=product,item,goods,barang,produk,isi
